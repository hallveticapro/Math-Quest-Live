{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent $npm_execpath\" in *pnpm*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "set -a; [ ! -f .env ] || . ./.env; set +a; pnpm -r --parallel --filter @workspace/api-server --filter @workspace/mathquest-live run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "NODE_ENV=${NODE_ENV:-production} PORT=${PORT:-3000} STATIC_DIR=${STATIC_DIR:-artifacts/mathquest-live/dist/public} node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "validate:math": "pnpm --filter @workspace/scripts exec tsx ../artifacts/mathquest-live/src/validateMath.ts",
    "validate:images": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/images/validateImages.ts"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
