# Copy this file to .env and fill in real local values.
# Never commit .env.

OPENAI_API_KEY=your_openai_api_key_here

PORT=3000
NODE_ENV=production
OPENAI_MODEL=gpt-4.1-mini

# Local frontend development settings.
FRONTEND_PORT=18567
HOST=127.0.0.1
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# Production static file serving. Usually only needed outside Docker.
STATIC_DIR=artifacts/mathquest-live/dist/public
