# Copy this file to .env and fill in real local values.
# Never commit .env.

OPENAI_API_KEY=your_openai_api_key_here

PORT=3000
NODE_ENV=production
OPENAI_MODEL=gpt-4.1-mini
STORY_TIMEOUT_MS=30000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
IMAGE_RATE_LIMIT_MAX_REQUESTS=20
CORS_ORIGIN=*
TRUST_PROXY=false
MAX_PENDING_TURNS=120
MAX_PENDING_TURNS_PER_CLIENT=4
MAX_PENDING_TURNS_PER_EPISODE=2
MAX_EPISODE_PLANS=300
MAX_IMAGE_JOBS=120
MAX_STORED_IMAGES=120

# Optional backend-only AI image generation.
# Keep disabled unless you want OpenAI image requests and the related cost/latency.
ENABLE_IMAGE_GENERATION=false
IMAGE_MODE=cover_outro
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1024
IMAGE_STYLE=cartoon-fantasy
IMAGE_TIMEOUT_MS=45000
IMAGE_STORAGE_MODE=memory

# Local frontend development settings.
FRONTEND_PORT=18567
HOST=127.0.0.1
VITE_ALLOWED_HOSTS=
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# Production static file serving. Usually only needed outside Docker.
STATIC_DIR=artifacts/mathquest-live/dist/public
